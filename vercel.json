{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "installCommand": "npm ci --omit=dev --ignore-scripts --no-audit --no-fund",
  "redirects": [
    {
      "source": "/resources/field-notes/dodentocht-reporter-2026",
      "destination": "/resources/events/dodentocht/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/dodentocht-reporter-2026/",
      "destination": "/resources/events/dodentocht/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/dodentocht-unfinished-2026",
      "destination": "/resources/events/dodentocht/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/dodentocht-unfinished-2026/",
      "destination": "/resources/events/dodentocht/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/classic-sweden-external-interview",
      "destination": "/resources/events/fjallraven-classic-sweden/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/classic-sweden-external-interview/",
      "destination": "/resources/events/fjallraven-classic-sweden/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/nijmegen-returning-after-change",
      "destination": "/resources/events/nijmegen/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/nijmegen-returning-after-change/",
      "destination": "/resources/events/nijmegen/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/nijmegen-marching-tradition",
      "destination": "/resources/events/nijmegen/",
      "permanent": true
    },
    {
      "source": "/resources/field-notes/nijmegen-marching-tradition/",
      "destination": "/resources/events/nijmegen/",
      "permanent": true
    }
  ]
}
